{
  "name": "@dandyhorse/avatarkit",
  "private": true,
  "version": "0.1.0",
  "description": "Procedural, skinned Nintendo-style human avatars for Dandyhorse games: a spec, a builder, walk/run/cycle animation and a designer.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./designer": "./src/designer/designer.ts"
  },
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node tools/bench.ts"
  },
  "peerDependencies": {
    "@babylonjs/core": "9.26.0"
  },
  "devDependencies": {
    "@babylonjs/core": "9.26.0",
    "@types/node": "^24",
    "meshoptimizer": "^1.2.0",
    "typescript": "^5.8",
    "vite": "^7",
    "vitest": "^3.2"
  }
}
