# Credentials: copy to .env (git-ignored) and fill in. Never commit .env.
# A Cloudflare ACCOUNT API token with R2 read & write on the bucket: assetmgr derives R2's S3 key pair from it
# (key id = the token's id, secret = its SHA-256) and finds the account from it.
CLOUDFLARE_API_TOKEN=
# the shared asset bucket
CLOUDFLARE_BUCKET=assets
